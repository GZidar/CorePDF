<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <Description>A basic PDF document generation library for .Net</Description>
    <Authors>CorePDF Contributors</Authors>
    <Company />
    <Version>0.7.0</Version>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <Copyright>2024 CorePDF Contributors</Copyright>
    <PackageProjectUrl>https://github.com/GZidar/CorePDF</PackageProjectUrl>
    <RepositoryUrl>https://github.com/GZidar/CorePDF</RepositoryUrl>
	<PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryType>git</RepositoryType>
    <PackageTags>pdf-generation pdf .NET</PackageTags>
    <AssemblyVersion>0.7.0.0</AssemblyVersion>
    <FileVersion>0.7.0.0</FileVersion>
    <PackageLicenseFile>License.txt</PackageLicenseFile>
    <PackageIcon>corepdf.png</PackageIcon>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CorePDF.UnitTests" />
    <InternalsVisibleTo Include="CorePDF.IntegrationTests" />
  </ItemGroup>

	<ItemGroup>
		<None Include="..\README.md" Pack="true" PackagePath="\" />
		<None Include="..\License.txt" Pack="true" PackagePath="\" />
		<None Include="corepdf.png" Pack="true" PackagePath="\" />
	</ItemGroup>
</Project>
